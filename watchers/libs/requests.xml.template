<?xml version="1.0" ?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface">
  <name>requests</name>
  <summary>HTTP library for Python</summary>
  <description>Requests is an HTTP library, written in Python, for human beings. It allows you to send HTTP/1.1 requests extremely easily.</description>
  <homepage>https://github.com/psf/requests</homepage>

  <group license="Apache License 2.0">
    <environment name="PYTHONPATH" insert="."/>
    <implementation version="{version}" released="{released}" stability="stable">
      <manifest-digest/>
      <archive href="https://github.com/psf/requests/archive/{version-original}.tar.gz" type="application/x-compressed-tar" extract="requests-{version}"/>
    </implementation>
  </group>
</interface>
